# RAG Web App Backend — Environment Variables
# Copy this file to .env and fill in values as needed.

# --- Generation Model ---
# By default, the app uses Qwen2.5-1.5B-Instruct locally (same as the notebook).
# To use DeepSeek via HuggingFace API instead, set these:

# HF_TOKEN=your_huggingface_token_here
# USE_DEEPSEEK=false
# DEEPSEEK_MODEL=deepseek-ai/DeepSeek-R1
